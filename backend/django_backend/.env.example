# Copy this file to .env and fill in real values. Never commit .env.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL - dedicated application user (not root).
# Create the database and user with database/setup_mysql.ps1
DB_NAME=credit_card_payment_db
DB_USER=ccps_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Signing key for JWT access/refresh tokens. Use a long random value.
JWT_SECRET_KEY=change-me

# Frontend origins allowed to call /api/ from a browser (comma-separated).
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Production only (ignored while DJANGO_DEBUG=True) ---
# HTTPS redirect, HSTS and secure cookies switch on automatically when DEBUG is False.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# Only after submitting the domain to hstspreload.org:
# DJANGO_SECURE_HSTS_PRELOAD=False
# Set to True when running behind a TLS-terminating reverse proxy.
# DJANGO_SECURE_PROXY_SSL_HEADER=False
# Admin login lockout: failures per IP before a temporary block, and block length.
# ADMIN_LOGIN_MAX_FAILURES=5
# ADMIN_LOGIN_LOCKOUT_SECONDS=900

# API docs at /api/docs/ (Swagger UI), /api/redoc/ and /api/schema/. Set to False in production.
ENABLE_API_DOCS=True
