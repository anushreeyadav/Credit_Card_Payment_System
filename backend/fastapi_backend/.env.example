# Copy this file to .env and fill in real values. Never commit .env.

# MySQL - same database and application user as the Django backend.
DB_NAME=credit_card_payment_db
DB_USER=ccps_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Must be identical to JWT_SECRET_KEY in backend/django_backend/.env,
# so that access tokens issued by Django can be verified here.
JWT_SECRET_KEY=change-me

# Frontend origins allowed to call the API from a browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Swagger UI at /docs. Set to false in production.
ENABLE_API_DOCS=true
