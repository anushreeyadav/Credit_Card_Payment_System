# Copy to .env (git-ignored) and adjust if your backends run elsewhere.
#
# Only VITE_-prefixed variables reach the browser, and everything here ends up
# in the built JavaScript. Never put secrets (JWT keys, DB passwords) in this file.

# Django backend: auth, cards, transactions, admin
VITE_DJANGO_API_URL=http://127.0.0.1:8000

# FastAPI payment service
VITE_FASTAPI_URL=http://127.0.0.1:8001
