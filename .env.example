# docker compose settings. Copy to .env (or run docker/init-env.ps1, which fills in
# random secrets) and never commit .env.
FRONTEND_PORT=8080

DB_NAME=credit_card_payment_db
DB_USER=ccps_app
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

DJANGO_SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Optional first-run admin account (created once if missing).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost
DJANGO_SUPERUSER_PASSWORD=change-me

# Swagger UIs at /docs (FastAPI) and /api/docs/ (Django). Set False in production.
ENABLE_API_DOCS=True
