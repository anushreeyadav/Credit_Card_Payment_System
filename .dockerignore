# Keep secrets, local environments and generated files out of every image.
**/.env
**/.env.*
!**/.env.example
**/venv/
**/.venv/
**/node_modules/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/staticfiles/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
database/dumps/
screenshots/
security/probe_results.json
.git/
.vscode/
.idea/
*.log
