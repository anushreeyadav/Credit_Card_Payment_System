# =====================================================================
# Credit Card Payment System - .gitignore
# Local project. Never commit secrets, card data or database contents.
# =====================================================================

# ---------------------------------------------------------------------
# Environment variables & secrets
# ---------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!**/.env.example
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
.venv/
env/
ENV/
virtualenv/
.python-version

# Testing / coverage (pytest, pytest-cov)
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache/
.hypothesis/
nosetests.xml
*.cover

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/

# ---------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------
*.log
local_settings.py
backend/django_backend/staticfiles/
backend/django_backend/static_root/
backend/django_backend/media/
celerybeat-schedule
celerybeat.pid

# ---------------------------------------------------------------------
# FastAPI / Uvicorn
# ---------------------------------------------------------------------
backend/fastapi_backend/logs/
*.pid

# ---------------------------------------------------------------------
# React / Node
# ---------------------------------------------------------------------
node_modules/
frontend/build/
frontend/dist/
frontend/.vite/
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/

# ---------------------------------------------------------------------
# MySQL & database files
# ---------------------------------------------------------------------
# Dumps can contain real data - keep them local only
database/dumps/*
!database/dumps/.gitkeep
# The sanitised final dump (schema + reference data only; see database/README.md)
!database/dumps/credit_card_payment_system.sql
*.sql.gz
*.dump
*.bak
# Local database files
*.sqlite3
*.sqlite3-journal
*.db
db.sqlite3
# MySQL data directory (e.g. Docker volume bind mounts)
mysql_data/
database/data/
*.ibd
*.frm
*.myd
*.myi

# ---------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------
docker-compose.override.yml
docker/volumes/

# ---------------------------------------------------------------------
# Screenshots
# Put screenshots meant for the repo (e.g. README images) in screenshots/.
# Keep private or scratch captures in screenshots/private/ or
# screenshots/tmp/ - they are never committed.
# ---------------------------------------------------------------------
screenshots/private/
screenshots/tmp/
screenshots/**/*-draft.*
screenshots/**/*_draft.*

# ---------------------------------------------------------------------
# Postman - exported environments may hold tokens / passwords
# ---------------------------------------------------------------------
postman/*environment*.json
!postman/*environment*.example.json
postman/*globals*.json

# ---------------------------------------------------------------------
# IDE / editor files
# ---------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------------------------------------------------------------------
# OS-generated files
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------
# Generated / temporary files
# ---------------------------------------------------------------------
tmp/
temp/
*.tmp
*.temp
logs/

# Security probe output
security/probe_results.json

# Screenshots regenerated by the automated test suites (the submission set is screenshots/*.png)
screenshots/test-runs/
